{
  "name": "releaseway-npm-actions",
  "private": true,
  "version": "0.0.0",
  "description": "Releaseway GitHub Action for npm publication.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "update:toolchain": "node scripts/update-toolchain.mjs",
    "typecheck": "tsc --noEmit",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:yarn-corepack": "node scripts/verify-yarn-corepack.mjs",
    "verify:native-runtime": "node scripts/verify-native-runtime.mjs",
    "verify:native-install": "node scripts/verify-native-install.mjs",
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/semver": "7.8.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@yarnpkg/cli-dist": "4.18.1",
    "esbuild": "0.28.2",
    "fast-glob": "3.3.3",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
